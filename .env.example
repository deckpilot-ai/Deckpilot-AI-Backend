APP_ENV=development
APP_NAME=deckpilotAI
API_V1_PREFIX=/api/v1
JWT_SECRET=change-me-to-a-secure-32-byte-secret-key
KEY_ENCRYPTION_SECRET=change-me-to-a-secure-32-byte-secret-key
JWT_ISSUER=deckpilotai-backend
JWT_AUDIENCE=deckpilotai
JWT_EXPIRE_MINUTES=1440
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
SQLITE_DATABASE_URL=sqlite:///./deckpilotai_dev.db
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=deckpilotai
LOCAL_STORAGE_DIR=./local_storage
FRONTEND_ORIGIN=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
AI_PROVIDER_ALLOWED_HOSTS=openrouter.ai,api.openai.com,generativelanguage.googleapis.com,api.groq.com,api.mistral.ai,api.anthropic.com,api.experientiallabs.ai
MAX_UPLOAD_BYTES=26214400
DB_ECHO=false

# AI Providers & Keys
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
EXPERIENTIALLABS_API_KEY=
EXPERIENTIALLABS_BASE_URL=https://api.experientiallabs.ai/v1

